rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Single source of truth for "is this request from the admin
    // account" - was previously repeated as a literal email list in four
    // separate places (users/read, sessions/read, sessions/delete), which
    // is easy to update in three spots and forget the fourth. Still just
    // an email allowlist under the hood (Firestore rules can't reach out
    // to an env var or secret store), but now there's exactly one place
    // to change it.
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['drmo071990@gmail.com'];
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();

      // NOTE: subscription_expires_at and subscription_status must both be
      // listed here even though the client can't actually set them to
      // whatever it wants (see validAccountData() / the create+update
      // guards below). hasOnly() checks the FULL resulting document after
      // a write, so once the Worker (via the Admin SDK, which bypasses
      // these rules) sets these fields on a paying user, every future
      // client write to that same doc (e.g. saving cash/portfolio) would
      // be rejected by hasOnly() if these two keys weren't whitelisted -
      // the actual protection comes from the diff checks further down,
      // which block the *value* of subscription_expires_at from ever
      // being touched by the client, and restrict subscription_status to
      // only ever be client-settable as 'trial'.
      function allowedUserFields() {
        return ['cash', 'portfolio', 'history', 'paper_cash', 'paper_portfolio', 'paper_history',
                'agreed_to_terms', 'terms_version', 'agreed_at', 'ip_address', 'web_stats',
                'desktop_stats', 'trial_ends_at', 'subscription_status', 'subscription_expires_at'];
      }

      // web_stats (written by index.html's _writeCloudSyncNow(), via
      // computeWebDealingStats()) and desktop_stats (written by
      // app_gui.py's push_dealing_stats()) are the same shape from two
      // different writers - one shared validator for both instead of
      // duplicating the same four checks twice. Previously these two
      // fields were in allowedUserFields() (so the KEY was gated) but
      // had no validation on what's actually INSIDE the map at all -
      // a client could write any nested structure/size here.
      function validStatsMap(m) {
        return m.keys().hasOnly(['trade_count', 'total_trade_value_egp', 'portfolio_value_egp', 'updated'])
          && m.trade_count is int
          && m.trade_count >= 0
          && m.trade_count <= 1000000
          && m.total_trade_value_egp is number
          && m.total_trade_value_egp >= 0
          && m.total_trade_value_egp <= 1000000000000
          && m.portfolio_value_egp is number
          && m.portfolio_value_egp >= 0
          && m.portfolio_value_egp <= 1000000000000
          && m.updated is timestamp;
      }

      // Only used by `create`, where cash/portfolio/history (and now
      // paper_cash/paper_portfolio/paper_history - the paper-trading
      // counterpart, see index.html/login.html) are always being set for
      // the first time - unconditional checks are correct here (a
      // brand-new account must start from a valid state).
      function validAccountData() {
        return request.resource.data.cash is number
          && request.resource.data.cash >= 0
          && request.resource.data.cash <= 100000000
          && request.resource.data.portfolio is list
          && request.resource.data.portfolio.size() <= 200
          && request.resource.data.history is list
          && request.resource.data.history.size() <= 5000
          && request.resource.data.paper_cash is number
          && request.resource.data.paper_cash >= 0
          && request.resource.data.paper_cash <= 100000000
          && request.resource.data.paper_portfolio is list
          && request.resource.data.paper_portfolio.size() <= 200
          && request.resource.data.paper_history is list
          && request.resource.data.paper_history.size() <= 5000
          && (
                !("ip_address" in request.resource.data)
                || request.resource.data.ip_address == null
                || request.resource.data.ip_address is string
             )
          && (
                !("trial_ends_at" in request.resource.data)
                || request.resource.data.trial_ends_at is timestamp
             )
          && (
                !("subscription_status" in request.resource.data)
                || request.resource.data.subscription_status is string
             )
          && (
                !("web_stats" in request.resource.data)
                || (request.resource.data.web_stats is map && validStatsMap(request.resource.data.web_stats))
             )
          && (
                !("desktop_stats" in request.resource.data)
                || (request.resource.data.desktop_stats is map && validStatsMap(request.resource.data.desktop_stats))
             );
      }

      // Used by `update`. request.resource.data is the FULL document after
      // the write (see NOTE above), so cash/portfolio/history are almost
      // always present even when this particular write doesn't touch them -
      // but on some older accounts they were never set. Unconditionally
      // validating them (as validAccountData() does) then rejects EVERY
      // future update to that account forever, including totally unrelated
      // writes like re-accepting updated terms. Only validate a field here
      // if THIS write is actually the one changing it; an update that never
      // touches cash/portfolio/history should not be blocked by whatever
      // state those fields happen to already be in. Same reasoning applies
      // to paper_cash/paper_portfolio/paper_history below - accounts that
      // existed before paper trading shipped won't have these fields set,
      // and that must not block unrelated future updates either.
      function validPartialUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return (
                !("cash" in changed)
                || (
                      request.resource.data.cash is number
                      && request.resource.data.cash >= 0
                      && request.resource.data.cash <= 100000000
                   )
             )
          && (
                !("portfolio" in changed)
                || (
                      request.resource.data.portfolio is list
                      && request.resource.data.portfolio.size() <= 200
                   )
             )
          && (
                !("history" in changed)
                || (
                      request.resource.data.history is list
                      && request.resource.data.history.size() <= 5000
                   )
             )
          && (
                !("paper_cash" in changed)
                || (
                      request.resource.data.paper_cash is number
                      && request.resource.data.paper_cash >= 0
                      && request.resource.data.paper_cash <= 100000000
                   )
             )
          && (
                !("paper_portfolio" in changed)
                || (
                      request.resource.data.paper_portfolio is list
                      && request.resource.data.paper_portfolio.size() <= 200
                   )
             )
          && (
                !("paper_history" in changed)
                || (
                      request.resource.data.paper_history is list
                      && request.resource.data.paper_history.size() <= 5000
                   )
             )
          && (
                !("ip_address" in changed)
                || request.resource.data.ip_address == null
                || request.resource.data.ip_address is string
             )
          && (
                !("trial_ends_at" in changed)
                || request.resource.data.trial_ends_at is timestamp
             )
          && (
                !("subscription_status" in changed)
                || request.resource.data.subscription_status is string
             )
          && (
                !("web_stats" in changed)
                || (request.resource.data.web_stats is map && validStatsMap(request.resource.data.web_stats))
             )
          && (
                !("desktop_stats" in changed)
                || (request.resource.data.desktop_stats is map && validStatsMap(request.resource.data.desktop_stats))
             );
      }

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(allowedUserFields())
        && request.resource.data.agreed_to_terms == true
        && request.resource.data.terms_version is string
        && request.resource.data.terms_version.size() > 0
        && request.resource.data.agreed_at is timestamp
        && validAccountData()
        // A brand-new account may only ever be created as a free trial -
        // never as an already-active paid subscription, and never with a
        // subscription_expires_at set (that only ever comes from the
        // Worker, which bypasses these rules entirely via the Admin SDK).
        && (!("subscription_status" in request.resource.data) || request.resource.data.subscription_status == 'trial')
        && !("subscription_expires_at" in request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == userId
        // Only the KEYS BEING CHANGED by this write need to be in the
        // allowed set - NOT every key already on the document. Checking
        // the full document (as this used to) meant that if ANY process
        // with elevated access (e.g. the payments Worker via the Admin
        // SDK, which bypasses these rules entirely) ever wrote a field
        // not in allowedUserFields(), hasOnly() would fail forever after
        // that point - permanently blocking every future client write to
        // that user's doc, including totally unrelated ones like
        // re-accepting updated terms. Scoping the check to affectedKeys()
        // still stops the client from ever writing a disallowed field
        // itself, without being able to be broken by fields the client
        // never touched.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedUserFields())
        && validPartialUpdate()
        && (
              !("agreed_to_terms" in resource.data)
              || resource.data.agreed_to_terms == true
           )
        && (
              !("agreed_to_terms" in request.resource.data.diff(resource.data).affectedKeys())
              || (
                    request.resource.data.agreed_to_terms == true
                    && request.resource.data.terms_version is string
                    && request.resource.data.terms_version.size() > 0
                    && request.resource.data.agreed_at is timestamp
                 )
           )
        // The client can never change subscription_expires_at - only the
        // Worker (Admin SDK, bypasses rules) may set/update it.
        && !("subscription_expires_at" in request.resource.data.diff(resource.data).affectedKeys())
        // The client may only ever change subscription_status TO 'trial'
        // (e.g. the one-time trial migration for pre-existing accounts).
        // It can never set it to 'active' - only the Worker does that.
        && (
              !("subscription_status" in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.subscription_status == 'trial'
           );
    }
    match /sessions/{sessionId} {
      // SECURITY: previously had no schema validation at all beyond "the
      // uid field matches the caller" - an authenticated client could
      // write a session doc with arbitrary extra fields and no size
      // limit (own doc, so unbounded storage growth / cost is the
      // realistic risk here, not privilege escalation, since these
      // fields are never used to grant access). Mirrors the users/
      // collection's own create/update split: create validates the
      // WHOLE new doc, update only validates whatever this write
      // actually changes - see that match block's own comments for why.
      //
      // Schema matches exactly what index.html's startSessionTracking()
      // and app_gui.py's create_session_doc() actually write: uid,
      // email (nullable), name, source ('web' | 'desktop'), start,
      // lastSeen.
      function validSessionCreate() {
        return request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'source', 'start', 'lastSeen'])
          && request.resource.data.uid is string
          && (
                !('email' in request.resource.data)
                || request.resource.data.email == null
                || request.resource.data.email is string
             )
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200
          && request.resource.data.source is string
          && request.resource.data.source in ['web', 'desktop']
          && request.resource.data.start is timestamp
          && request.resource.data.lastSeen is timestamp;
      }

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && validSessionCreate();

      // Every observed update site (the web tab's heartbeat, the desktop
      // app's touch_session_doc()) only ever touches lastSeen - lock the
      // rule down to exactly that instead of allowing any field on an
      // "update", which previously let the owner rewrite uid/email/name/
      // source on their own session doc after creation.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
        && request.resource.data.lastSeen is timestamp;

      allow read:   if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
