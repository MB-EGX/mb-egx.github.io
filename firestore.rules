rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.token.email in ['drmo071990@gmail.com'];

      // NOTE: subscription_expires_at and subscription_status must both be
      // listed here even though the client can't actually set them to
      // whatever it wants (see validAccountData() / the create+update
      // guards below). hasOnly() checks the FULL resulting document after
      // a write, so once the Worker (via the Admin SDK, which bypasses
      // these rules) sets these fields on a paying user, every future
      // client write to that same doc (e.g. saving cash/portfolio) would
      // be rejected by hasOnly() if these two keys weren't whitelisted -
      // the actual protection comes from the diff checks further down,
      // which block the *value* of subscription_expires_at from ever
      // being touched by the client, and restrict subscription_status to
      // only ever be client-settable as 'trial'.
      function allowedUserFields() {
        return ['cash', 'portfolio', 'history', 'agreed_to_terms', 'terms_version', 'agreed_at', 'web_stats',
                'desktop_stats', 'trial_ends_at', 'subscription_status', 'subscription_expires_at'];
      }

      // Only used by `create`, where cash/portfolio/history are always
      // being set for the first time - unconditional checks are correct
      // here (a brand-new account must start from a valid state).
      function validAccountData() {
        return request.resource.data.cash is number
          && request.resource.data.cash >= 0
          && request.resource.data.cash <= 100000000
          && request.resource.data.portfolio is list
          && request.resource.data.portfolio.size() <= 200
          && request.resource.data.history is list
          && request.resource.data.history.size() <= 5000
          && (
                !("trial_ends_at" in request.resource.data)
                || request.resource.data.trial_ends_at is timestamp
             )
          && (
                !("subscription_status" in request.resource.data)
                || request.resource.data.subscription_status is string
             );
      }

      // Used by `update`. request.resource.data is the FULL document after
      // the write (see NOTE above), so cash/portfolio/history are almost
      // always present even when this particular write doesn't touch them -
      // but on some older accounts they were never set. Unconditionally
      // validating them (as validAccountData() does) then rejects EVERY
      // future update to that account forever, including totally unrelated
      // writes like re-accepting updated terms. Only validate a field here
      // if THIS write is actually the one changing it; an update that never
      // touches cash/portfolio/history should not be blocked by whatever
      // state those fields happen to already be in.
      function validPartialUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return (
                !("cash" in changed)
                || (
                      request.resource.data.cash is number
                      && request.resource.data.cash >= 0
                      && request.resource.data.cash <= 100000000
                   )
             )
          && (
                !("portfolio" in changed)
                || (
                      request.resource.data.portfolio is list
                      && request.resource.data.portfolio.size() <= 200
                   )
             )
          && (
                !("history" in changed)
                || (
                      request.resource.data.history is list
                      && request.resource.data.history.size() <= 5000
                   )
             )
          && (
                !("trial_ends_at" in changed)
                || request.resource.data.trial_ends_at is timestamp
             )
          && (
                !("subscription_status" in changed)
                || request.resource.data.subscription_status is string
             );
      }

      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(allowedUserFields())
        && request.resource.data.agreed_to_terms == true
        && request.resource.data.terms_version is string
        && request.resource.data.terms_version.size() > 0
        && request.resource.data.agreed_at is timestamp
        && validAccountData()
        // A brand-new account may only ever be created as a free trial -
        // never as an already-active paid subscription, and never with a
        // subscription_expires_at set (that only ever comes from the
        // Worker, which bypasses these rules entirely via the Admin SDK).
        && (!("subscription_status" in request.resource.data) || request.resource.data.subscription_status == 'trial')
        && !("subscription_expires_at" in request.resource.data);
      allow update: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == userId
        // Only the KEYS BEING CHANGED by this write need to be in the
        // allowed set - NOT every key already on the document. Checking
        // the full document (as this used to) meant that if ANY process
        // with elevated access (e.g. the payments Worker via the Admin
        // SDK, which bypasses these rules entirely) ever wrote a field
        // not in allowedUserFields(), hasOnly() would fail forever after
        // that point - permanently blocking every future client write to
        // that user's doc, including totally unrelated ones like
        // re-accepting updated terms. Scoping the check to affectedKeys()
        // still stops the client from ever writing a disallowed field
        // itself, without being able to be broken by fields the client
        // never touched.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedUserFields())
        && validPartialUpdate()
        && (
              !("agreed_to_terms" in resource.data)
              || resource.data.agreed_to_terms == true
           )
        && (
              !("agreed_to_terms" in request.resource.data.diff(resource.data).affectedKeys())
              || (
                    request.resource.data.agreed_to_terms == true
                    && request.resource.data.terms_version is string
                    && request.resource.data.terms_version.size() > 0
                    && request.resource.data.agreed_at is timestamp
                 )
           )
        // The client can never change subscription_expires_at - only the
        // Worker (Admin SDK, bypasses rules) may set/update it.
        && !("subscription_expires_at" in request.resource.data.diff(resource.data).affectedKeys())
        // The client may only ever change subscription_status TO 'trial'
        // (e.g. the one-time trial migration for pre-existing accounts).
        // It can never set it to 'active' - only the Worker does that.
        && (
              !("subscription_status" in request.resource.data.diff(resource.data).affectedKeys())
              || request.resource.data.subscription_status == 'trial'
           );
    }
    match /sessions/{sessionId} {
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.token.email_verified == true
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'last_seen_at', 'user_agent', 'device_type']);
      allow read:   if request.auth != null && request.auth.token.email in ['drmo071990@gmail.com'];
      allow delete: if request.auth != null && request.auth.token.email in ['drmo071990@gmail.com'];
    }
  }
}
